# Hermes Payment - Variáveis de Ambiente Locais

# Database PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=hermes
POSTGRES_USER=hermes
POSTGRES_PASSWORD=hermes_secret

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# Kafka
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# RabbitMQ
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest

# OpenTelemetry / Observabilidade
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
TEMPO_PORT=3200
LOKI_PORT=3100
JAEGER_PORT=16686

# IAM Bootstrap
HERMES_BOOTSTRAP_ENABLED=true
HERMES_MASTER_USERNAME=admin
HERMES_MASTER_EMAIL=admin@hermes.io
HERMES_MASTER_FULLNAME=System Master Admin
HERMES_MASTER_PASSWORD=AdminMasterSecret123!
